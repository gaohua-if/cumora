# Copy this file to .env.docker before running Docker Compose.
# Do not commit .env.docker: it contains deployment secrets.

NODE_ENV=production
PORT=5181

# Keep POSTGRES_PASSWORD and the password inside DATABASE_URL identical.
# URL-encode special characters used inside DATABASE_URL.
POSTGRES_USER=cumora
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
POSTGRES_DB=cumora
DATABASE_URL=postgres://cumora:CHANGE_THIS_DATABASE_PASSWORD@postgres:5432/cumora
REDIS_URL=redis://redis:6379

# Required by the current server, including BYOA-only deployments.
OPENAI_API_KEY=sk-REPLACE_ME

# Generate with: openssl rand -hex 32
AGENT_RUNTIME_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Standalone Docker mode: disable every Kubernetes background path.
ENABLE_AGENT_POD_GC=false
ENABLE_CHROME_PVC_GC=false
ENABLE_CLUSTER_MONITOR=false
WORKSPACE_RUNTIME_CLEANUP_ENABLED=false
CUMORA_KUBECTL=/bin/false

# Replace localhost with the LAN hostname or HTTPS origin users actually open.
CUMORA_PUBLIC_ORIGIN=http://localhost:5181
CUMORA_AUTH_DONE_URL=http://localhost:5181/
CUMORA_AUTH_RETURN_ALLOWLIST=http://localhost:5181/
CUMORA_INVITE_BASE_URL=http://localhost:5181
CUMORA_ADMIN_EMAILS=admin@example.lan

# Configure at least one OAuth provider. A self-hosted GitLab is suitable for
# an isolated LAN. Its callback is <CUMORA_PUBLIC_ORIGIN>/api/auth/callback/gitlab.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_BASE_URL=https://gitlab.example.lan
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Optional external integrations are disabled for the standalone LAN profile.
RESEND_API_KEY=
EMAIL_DOMAIN=
EMAIL_INBOUND_HMAC_SECRET=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE=
R2_URL_SIGNING_SECRET=
